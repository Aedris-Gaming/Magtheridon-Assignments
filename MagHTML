<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Magtheridon — Assignments</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@600;800&family=JetBrains+Mono:wght@500;700&display=swap" rel="stylesheet">
<style>
  :root {
    --bg: #0a0604;
    --panel: rgba(25, 14, 8, 0.85);
    --border: rgba(201, 160, 90, 0.3);
    --parchment: #e0cba0;
    --dim: #9a8765;
    --ember: #e8a04a;
    --blood: #c41e1e;
    --green: #7ad97a;
    --purple: #b07ad9;
    --clicker: #ffd96b;
    --g1: #e85a5a;
    --g2: #5a9ce8;
    --g3: #5ae89c;
    --g4: #c97ae8;
    --g5: #e8c95a;
  }

  * { box-sizing: border-box; margin: 0; padding: 0; }

  html, body {
    background: var(--bg);
    background-image:
      radial-gradient(ellipse at top, rgba(196, 30, 30, 0.15) 0%, transparent 50%),
      linear-gradient(180deg, #0a0604 0%, #15090a 100%);
    background-attachment: fixed;
    color: var(--parchment);
    font-family: 'JetBrains Mono', monospace;
    font-size: 13px;
    line-height: 1.3;
    min-height: 100vh;
    -webkit-user-select: none;
    user-select: none;
  }

  .page {
    max-width: 1200px;
    margin: 0 auto;
    padding: 14px 18px;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-bottom: 8px;
    border-bottom: 1px solid var(--border);
  }
  h1 {
    font-family: 'Cinzel', serif;
    font-weight: 800;
    font-size: 20px;
    letter-spacing: 0.2em;
    color: var(--parchment);
    text-shadow: 0 0 20px rgba(196, 30, 30, 0.4);
  }
  .meta {
    font-size: 10px;
    letter-spacing: 0.25em;
    color: var(--ember);
    text-transform: uppercase;
  }

  .panel {
    background: var(--panel);
    border: 1px solid var(--border);
    padding: 10px 14px;
  }
  .panel-title {
    font-family: 'Cinzel', serif;
    font-weight: 700;
    font-size: 10px;
    letter-spacing: 0.3em;
    color: var(--ember);
    text-transform: uppercase;
    margin-bottom: 8px;
    padding-bottom: 5px;
    border-bottom: 1px dashed var(--border);
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 6px;
  }
  .panel-title .hint {
    color: var(--dim);
    font-weight: 500;
    letter-spacing: 0.15em;
    font-size: 9px;
  }

  .top-row {
    display: grid;
    grid-template-columns: 1fr 480px;
    gap: 10px;
  }

  .parties {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 8px;
  }
  .party {
    background: rgba(40, 22, 12, 0.5);
    border: 1px solid var(--border);
    padding: 8px 10px;
    display: flex;
    flex-direction: column;
    gap: 3px;
    border-top: 3px solid var(--p-color, var(--ember));
  }
  .party.g1 { --p-color: var(--g1); }
  .party.g2 { --p-color: var(--g2); }
  .party.g3 { --p-color: var(--g3); }
  .party.g4 { --p-color: var(--g4); }
  .party.g5 { --p-color: var(--g5); }

  .party-label {
    font-family: 'Cinzel', serif;
    font-weight: 800;
    font-size: 11px;
    letter-spacing: 0.3em;
    color: var(--p-color, var(--ember));
    text-align: center;
    padding-bottom: 5px;
    margin-bottom: 3px;
    border-bottom: 1px dashed rgba(201, 160, 90, 0.2);
  }
  .pmember {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 2px 0;
    font-family: 'Cinzel', serif;
    font-weight: 600;
    font-size: 12px;
    color: var(--parchment);
  }

  .room-wrap { display: flex; flex-direction: column; }
  .room, .pos-map {
    position: relative;
    width: 100%;
    aspect-ratio: 700 / 525;
    border-radius: 50%;
    overflow: hidden;
    background:
      radial-gradient(circle at 30% 25%, rgba(80, 130, 110, 0.18), transparent 60%),
      radial-gradient(circle at 70% 75%, rgba(40, 80, 70, 0.25), transparent 60%),
      radial-gradient(ellipse at center, #2a4a3e 0%, #1a2e26 55%, #0a1410 100%);
    border: 2px solid #4a6258;
    box-shadow:
      inset 0 0 60px rgba(0,0,0,0.8),
      inset 0 0 0 6px rgba(20, 35, 28, 0.6);
    touch-action: none;
  }
  .room::before, .pos-map::before {
    content: '';
    position: absolute;
    inset: 0;
    background-image:
      repeating-conic-gradient(from 0deg at 50% 50%, rgba(60, 90, 78, 0.18) 0deg 18deg, rgba(30, 50, 42, 0.18) 18deg 36deg),
      radial-gradient(circle at 50% 50%, transparent 0%, transparent 30%, rgba(0,0,0,0.4) 80%);
    mix-blend-mode: overlay;
    opacity: 0.7;
    pointer-events: none;
  }
  .room::after, .pos-map::after {
    content: '';
    position: absolute;
    inset: 4%;
    border-radius: 50%;
    border: 1px dashed rgba(201, 160, 90, 0.15);
    pointer-events: none;
  }

  .mag-center {
    position: absolute;
    top: 50%; left: 50%;
    transform: translate(-50%, -50%);
    width: 60px; height: 60px;
    border-radius: 50%;
    background: radial-gradient(circle at 35% 35%, #ff6a3a 0%, #c41e1e 35%, #5a0808 70%, #1a0202 100%);
    box-shadow:
      0 0 35px rgba(196, 30, 30, 0.8),
      0 0 70px rgba(196, 30, 30, 0.35),
      inset 0 0 18px rgba(0,0,0,0.7),
      inset 0 0 0 2px rgba(0,0,0,0.6);
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: 'Cinzel', serif;
    font-weight: 800;
    font-size: 10px;
    color: #ffe8d0;
    letter-spacing: 0.2em;
    text-align: center;
    text-shadow: 0 0 6px #000, 0 1px 2px #000;
    z-index: 4;
  }
  .mag-arrow {
    position: absolute;
    top: 50%; left: 50%;
    transform: translate(-50%, calc(-50% - 42px));
    width: 0; height: 0;
    border-left: 8px solid transparent;
    border-right: 8px solid transparent;
    border-bottom: 12px solid rgba(255, 100, 60, 0.85);
    z-index: 4;
    filter: drop-shadow(0 0 4px rgba(196, 30, 30, 0.6));
  }

  .channeler {
    position: absolute;
    transform: translate(-50%, -50%);
    text-align: center;
    z-index: 3;
    width: 110px;
  }
  .ch-skull    { top: 14%; left: 50%; }
  .ch-x        { top: 42%; left: 84%; }
  .ch-triangle { top: 84%; left: 70%; }
  .ch-moon     { top: 84%; left: 30%; }
  .ch-square   { top: 42%; left: 16%; }

  .marker {
    width: 38px; height: 38px;
    border-radius: 50%;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-family: 'Cinzel', serif;
    font-weight: 800;
    font-size: 20px;
    color: #000;
    border: 2px solid rgba(0,0,0,0.6);
    box-shadow:
      0 0 16px currentColor,
      0 0 4px #000,
      inset 0 0 6px rgba(0,0,0,0.3),
      0 2px 6px rgba(0,0,0,0.7);
    margin: 0 auto 5px;
  }
  .marker.skull    { background: #f0f0f0; color: #1a1a1a; }
  .marker.x        { background: #d63333; color: #fff; }
  .marker.square   { background: #4a8fd6; color: #fff; }
  .marker.triangle { background: #4ad66b; color: #1a1a1a; }
  .marker.moon     { background: #7ec3e8; color: #1a1a1a; }

  .marker-sm {
    width: 22px; height: 22px;
    border-radius: 50%;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-family: 'Cinzel', serif;
    font-weight: 800;
    font-size: 12px;
    color: #000;
    flex-shrink: 0;
    border: 1px solid rgba(0,0,0,0.4);
  }
  .marker-sm.skull    { background: #e6e6e6; }
  .marker-sm.x        { background: #d63333; color: #fff; }
  .marker-sm.square   { background: #4a8fd6; color: #fff; }
  .marker-sm.triangle { background: #4ad66b; }
  .marker-sm.moon     { background: #7ec3e8; }

  .ch-clickers {
    background: rgba(15, 8, 4, 0.88);
    border: 1px solid rgba(255, 217, 107, 0.45);
    border-radius: 3px;
    padding: 4px 6px;
    display: flex;
    flex-direction: column;
    gap: 1px;
  }
  .ch-clicker-line {
    display: flex;
    align-items: center;
    gap: 5px;
    font-family: 'Cinzel', serif;
    font-weight: 700;
    font-size: 10px;
    color: var(--clicker);
    text-shadow: 0 1px 2px #000;
    line-height: 1.2;
    white-space: nowrap;
  }
  .ch-num {
    width: 12px; height: 12px;
    font-family: 'JetBrains Mono', monospace;
    font-size: 8px;
    color: #1a0d04;
    background: var(--clicker);
    border-radius: 50%;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    font-weight: 700;
  }

  .toolbar {
    display: flex;
    gap: 6px;
    margin-bottom: 10px;
    flex-wrap: wrap;
    align-items: center;
  }
  .sel-btn, .tool-btn {
    background: rgba(40, 22, 12, 0.7);
    border: 1px solid var(--border);
    color: var(--parchment);
    font-family: 'Cinzel', serif;
    font-weight: 700;
    font-size: 11px;
    letter-spacing: 0.2em;
    padding: 7px 14px;
    cursor: pointer;
    transition: all 0.15s;
    text-transform: uppercase;
  }
  .sel-btn:hover, .tool-btn:hover { background: rgba(60, 35, 18, 0.8); }
  .sel-btn.active {
    background: var(--btn-color, var(--ember));
    color: #1a0d04;
    border-color: var(--btn-color, var(--ember));
    box-shadow: 0 0 12px var(--btn-color, var(--ember));
  }
  .sel-btn[data-party="all"] { --btn-color: var(--ember); }
  .sel-btn[data-party="1"]   { --btn-color: var(--g1); }
  .sel-btn[data-party="2"]   { --btn-color: var(--g2); }
  .sel-btn[data-party="3"]   { --btn-color: var(--g3); }
  .sel-btn[data-party="4"]   { --btn-color: var(--g4); }
  .sel-btn[data-party="5"]   { --btn-color: var(--g5); }

  .tool-btn { border-color: rgba(122, 217, 122, 0.4); }
  .tool-btn.danger { border-color: rgba(196, 30, 30, 0.6); color: #ffb0b0; }
  .tool-btn.active-edit {
    background: var(--green);
    color: #0a1410;
    border-color: var(--green);
    box-shadow: 0 0 12px rgba(122, 217, 122, 0.6);
  }
  .tool-divider {
    width: 1px;
    height: 24px;
    background: var(--border);
    margin: 0 4px;
  }

  .pos-map-wrap {
    display: grid;
    grid-template-columns: 1fr 220px;
    gap: 14px;
  }

  .pos-map.editing { cursor: crosshair; }
  .pos-map.editing .raider { cursor: grab; }
  .pos-map.editing .raider:active { cursor: grabbing; }
  .pos-map.editing .raider .dot {
    box-shadow: 0 0 10px var(--p-color), 0 0 4px #fff, 0 1px 3px rgba(0,0,0,0.8);
  }

  .pos-map .mag-center { width: 50px; height: 50px; font-size: 9px; }
  .pos-map .mag-arrow { transform: translate(-50%, calc(-50% - 36px)); }

  .pos-marker {
    position: absolute;
    transform: translate(-50%, -50%);
    z-index: 5;
    text-align: center;
    pointer-events: none;
  }
  .pos-marker .marker-tiny {
    width: 26px; height: 26px;
    border-radius: 50%;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-family: 'Cinzel', serif;
    font-weight: 800;
    font-size: 13px;
    color: #000;
    border: 1.5px solid rgba(0,0,0,0.6);
    box-shadow:
      0 0 10px currentColor,
      0 0 3px #000,
      0 1px 4px rgba(0,0,0,0.7);
    margin: 0 auto 2px;
  }
  .pos-marker .marker-tiny.skull    { background: #f0f0f0; color: #1a1a1a; }
  .pos-marker .marker-tiny.x        { background: #d63333; color: #fff; }
  .pos-marker .marker-tiny.square   { background: #4a8fd6; color: #fff; }
  .pos-marker .marker-tiny.triangle { background: #4ad66b; color: #1a1a1a; }
  .pos-marker .marker-tiny.moon     { background: #7ec3e8; color: #1a1a1a; }

  .raider {
    position: absolute;
    transform: translate(-50%, -50%);
    z-index: 6;
    text-align: center;
    transition: opacity 0.25s;
    touch-action: none;
  }
  .raider.dragging {
    transition: none;
    z-index: 99;
  }
  .raider.dragging .dot {
    transform: scale(1.5);
    box-shadow: 0 0 16px var(--p-color), 0 0 8px #fff, 0 1px 4px rgba(0,0,0,0.9);
  }
  .raider .dot {
    width: 14px; height: 14px;
    border-radius: 50%;
    background: var(--p-color);
    border: 1.5px solid #1a0d04;
    box-shadow: 0 0 6px var(--p-color), 0 1px 3px rgba(0,0,0,0.8);
    margin: 0 auto 1px;
    transition: transform 0.15s, box-shadow 0.15s;
  }
  .raider .dot.is-clicker {
    border: 2px solid var(--clicker);
    box-shadow: 0 0 8px var(--clicker), 0 0 4px var(--p-color);
  }
  .raider .name {
    font-family: 'Cinzel', serif;
    font-weight: 700;
    font-size: 9px;
    color: #fff;
    text-shadow: 0 0 3px #000, 0 1px 2px #000, -1px 0 1px #000, 1px 0 1px #000;
    white-space: nowrap;
    letter-spacing: 0.04em;
    pointer-events: none;
  }
  .raider.g1 { --p-color: var(--g1); }
  .raider.g2 { --p-color: var(--g2); }
  .raider.g3 { --p-color: var(--g3); }
  .raider.g4 { --p-color: var(--g4); }
  .raider.g5 { --p-color: var(--g5); }

  .pos-map.filtered .raider:not(.highlight) {
    opacity: 0.18;
  }
  .pos-map.filtered .raider.highlight {
    z-index: 8;
  }
  .pos-map.filtered .raider.highlight .dot {
    transform: scale(1.3);
    box-shadow: 0 0 14px var(--p-color), 0 0 6px #fff;
  }
  .pos-map.filtered .raider.highlight .name {
    font-size: 10px;
  }

  .pos-info {
    background: rgba(40, 22, 12, 0.5);
    border: 1px solid var(--border);
    padding: 10px 12px;
    font-size: 11px;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .pos-info-title {
    font-family: 'Cinzel', serif;
    font-weight: 700;
    color: var(--ember);
    font-size: 10px;
    letter-spacing: 0.25em;
    text-transform: uppercase;
    padding-bottom: 5px;
    border-bottom: 1px dashed var(--border);
  }
  .legend-row {
    display: flex;
    align-items: center;
    gap: 8px;
    font-family: 'Cinzel', serif;
    font-size: 11px;
  }
  .legend-dot {
    width: 12px; height: 12px;
    border-radius: 50%;
    flex-shrink: 0;
    border: 1px solid #1a0d04;
  }
  .legend-dot.g1 { background: var(--g1); }
  .legend-dot.g2 { background: var(--g2); }
  .legend-dot.g3 { background: var(--g3); }
  .legend-dot.g4 { background: var(--g4); }
  .legend-dot.g5 { background: var(--g5); }
  .legend-dot.clicker { background: transparent; border: 2px solid var(--clicker); box-shadow: 0 0 4px var(--clicker); }

  .pos-info .helper {
    font-style: italic;
    color: var(--dim);
    font-size: 10px;
    line-height: 1.4;
  }

  .save-status {
    color: var(--green);
    font-size: 10px;
    font-style: italic;
    margin-left: 6px;
    opacity: 0;
    transition: opacity 0.3s;
  }
  .save-status.show { opacity: 1; }

  table.interrupts {
    width: 100%;
    border-collapse: collapse;
  }
  table.interrupts th, table.interrupts td {
    padding: 6px 8px;
    text-align: left;
    border-bottom: 1px solid rgba(201, 160, 90, 0.1);
  }
  table.interrupts th {
    font-family: 'Cinzel', serif;
    font-weight: 700;
    font-size: 10px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--dim);
    padding-bottom: 6px;
  }
  table.interrupts th.mending { color: var(--green); }
  table.interrupts th.volley { color: var(--purple); }
  table.interrupts td {
    font-size: 13px;
    font-weight: 500;
    color: var(--parchment);
  }
  table.interrupts tr:last-child td { border-bottom: none; }

  .marker-cell {
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .tank-name {
    font-family: 'Cinzel', serif;
    font-weight: 700;
    color: var(--parchment);
    font-size: 12px;
    letter-spacing: 0.05em;
  }
  .swap {
    color: var(--ember);
    font-style: italic;
    font-size: 11px;
  }
  .none-cell {
    color: var(--dim);
    font-style: italic;
  }

  .clickers {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 8px;
  }
  .cgroup {
    background: rgba(40, 22, 12, 0.5);
    border: 1px solid var(--border);
    padding: 7px 9px;
  }
  .cgroup-label {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    font-family: 'Cinzel', serif;
    font-weight: 700;
    font-size: 10px;
    letter-spacing: 0.25em;
    color: var(--clicker);
    margin-bottom: 5px;
    text-align: center;
    padding-bottom: 3px;
    border-bottom: 1px dashed rgba(201, 160, 90, 0.2);
  }
  .cline {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 2px 0;
    font-size: 12px;
    color: var(--parchment);
    font-family: 'Cinzel', serif;
    font-weight: 600;
  }
  .cnum {
    width: 16px; height: 16px;
    font-family: 'JetBrains Mono', monospace;
    font-size: 9px;
    color: var(--ember);
    border: 1px solid var(--ember);
    border-radius: 50%;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .lock-row {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    align-items: center;
  }
  .lock-item {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 12px;
  }
  .lock-item .label {
    font-family: 'Cinzel', serif;
    font-weight: 700;
    color: var(--ember);
    font-size: 10px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
  }
  .lock-item .name {
    font-family: 'Cinzel', serif;
    font-weight: 700;
    color: var(--parchment);
    letter-spacing: 0.05em;
  }
  .lock-item .arrow {
    color: var(--dim);
    margin: 0 2px;
    font-style: italic;
  }
  .lock-divider {
    width: 1px;
    height: 18px;
    background: var(--border);
  }
  .lock-warning { color: var(--blood); }

  @media (max-width: 900px) {
    .top-row { grid-template-columns: 1fr; }
    .parties { grid-template-columns: repeat(2, 1fr); }
    .clickers { grid-template-columns: repeat(2, 1fr); }
    .pos-map-wrap { grid-template-columns: 1fr; }
  }
</style>
</head>
<body>
<div class="page">

  <header>
    <h1>⚔ MAGTHERIDON</h1>
    <div class="meta">Parties · Cubes · Kicks</div>
  </header>

  <div class="top-row">

    <div class="panel">
      <div class="panel-title">
        <span>Parties</span>
        <span class="hint">Non-clickers stack behind boss</span>
      </div>
      <div class="parties">
        <div class="party g1">
          <div class="party-label">G 1</div>
          <div class="pmember">Yoyolanda</div>
          <div class="pmember">Unbearable</div>
          <div class="pmember">Kursd</div>
          <div class="pmember">Ameliore</div>
          <div class="pmember">Superfail</div>
        </div>
        <div class="party g2">
          <div class="party-label">G 2</div>
          <div class="pmember">Jarke</div>
          <div class="pmember">Excess</div>
          <div class="pmember">Rukkuz</div>
          <div class="pmember">Thiccstache</div>
          <div class="pmember">Mug</div>
        </div>
        <div class="party g3">
          <div class="party-label">G 3</div>
          <div class="pmember">Loxo</div>
          <div class="pmember">Aedris</div>
          <div class="pmember">Rommulus</div>
          <div class="pmember">Revorra</div>
          <div class="pmember">Starblind</div>
        </div>
        <div class="party g4">
          <div class="party-label">G 4</div>
          <div class="pmember">Pheals</div>
          <div class="pmember">Teiah</div>
          <div class="pmember">Nibsi</div>
          <div class="pmember">Shortshack</div>
