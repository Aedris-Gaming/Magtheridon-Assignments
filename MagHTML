<script>
  const STORAGE_KEY = 'mag-positions-v1';
  const allBtn = document.querySelector('.sel-btn[data-party="all"]');
  const partyBtns = document.querySelectorAll('.sel-btn:not([data-party="all"])');
  const editBtn = document.getElementById('editBtn');
  const resetBtn = document.getElementById('resetBtn');
  const posMap = document.getElementById('posMap');
  const raiders = posMap.querySelectorAll('.raider');
  const saveStatus = document.getElementById('saveStatus');

  // Capture defaults so reset works
  const defaults = {};
  raiders.forEach(r => {
    defaults[r.dataset.id] = { top: r.style.top, left: r.style.left };
  });

  // ===== Persistence (try shared storage, fall back to localStorage, fall back to memory) =====
  let memoryStore = null;

  async function savePositions() {
    const positions = {};
    raiders.forEach(r => {
      positions[r.dataset.id] = { top: r.style.top, left: r.style.left };
    });
    const json = JSON.stringify(positions);
    try {
      if (window.storage && window.storage.set) {
        await window.storage.set(STORAGE_KEY, json, true);
      } else if (window.localStorage) {
        localStorage.setItem(STORAGE_KEY, json);
      } else {
        memoryStore = json;
      }
      flashSaved();
    } catch (e) {
      try {
        if (window.localStorage) localStorage.setItem(STORAGE_KEY, json);
        else memoryStore = json;
        flashSaved();
      } catch {
        memoryStore = json;
      }
    }
  }

  async function loadPositions() {
    let json = null;
    try {
      if (window.storage && window.storage.get) {
        const result = await window.storage.get(STORAGE_KEY, true);
        if (result && result.value) json = result.value;
      }
    } catch {}
    if (!json) {
      try {
        if (window.localStorage) json = localStorage.getItem(STORAGE_KEY);
      } catch {}
    }
    if (!json) json = memoryStore;
    if (!json) return;
    try {
      const positions = JSON.parse(json);
      raiders.forEach(r => {
        const p = positions[r.dataset.id];
        if (p) {
          r.style.top = p.top;
          r.style.left = p.left;
        }
      });
    } catch {}
  }

  function flashSaved() {
    saveStatus.classList.add('show');
    clearTimeout(flashSaved._t);
    flashSaved._t = setTimeout(() => saveStatus.classList.remove('show'), 1200);
  }

  // ===== Party highlight (multi-toggle) =====
  function applyHighlight() {
    const active = Array.from(partyBtns)
      .filter(b => b.classList.contains('active'))
      .map(b => b.dataset.party);

    if (active.length === 0) {
      allBtn.classList.add('active');
      posMap.classList.remove('filtered');
      raiders.forEach(r => r.classList.remove('highlight'));
    } else {
      allBtn.classList.remove('active');
      posMap.classList.add('filtered');
      raiders.forEach(r => {
        if (active.includes(r.dataset.party)) r.classList.add('highlight');
        else r.classList.remove('highlight');
      });
    }
  }

  allBtn.addEventListener('click', () => {
    partyBtns.forEach(b => b.classList.remove('active'));
    applyHighlight();
  });
  partyBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      btn.classList.toggle('active');
      applyHighlight();
    });
  });

  // ===== Edit mode + dragging =====
  let editMode = false;
  editBtn.addEventListener('click', () => {
    editMode = !editMode;
    editBtn.classList.toggle('active-edit', editMode);
    posMap.classList.toggle('editing', editMode);
    editBtn.textContent = editMode ? '✓ Done Editing' : '✎ Edit Mode';
  });

  resetBtn.addEventListener('click', () => {
    if (!confirm('Reset all raider positions to defaults?')) return;
    raiders.forEach(r => {
      const d = defaults[r.dataset.id];
      r.style.top = d.top;
      r.style.left = d.left;
    });
    savePositions();
  });

  // Drag handling — pointer events for unified mouse/touch support
  let dragTarget = null;
  let dragOffsetX = 0;
  let dragOffsetY = 0;

  function getPercent(clientX, clientY) {
    const rect = posMap.getBoundingClientRect();
    const x = ((clientX - rect.left) / rect.width) * 100;
    const y = ((clientY - rect.top) / rect.height) * 100;
    return {
      x: Math.max(2, Math.min(98, x)),
      y: Math.max(2, Math.min(98, y))
    };
  }

  raiders.forEach(r => {
    r.addEventListener('pointerdown', (e) => {
      if (!editMode) return;
      e.preventDefault();
      dragTarget = r;
      r.classList.add('dragging');
      r.setPointerCapture(e.pointerId);
    });

    r.addEventListener('pointermove', (e) => {
      if (dragTarget !== r) return;
      e.preventDefault();
      const pos = getPercent(e.clientX, e.clientY);
      r.style.left = pos.x.toFixed(1) + '%';
      r.style.top = pos.y.toFixed(1) + '%';
    });

    r.addEventListener('pointerup', (e) => {
      if (dragTarget !== r) return;
      r.classList.remove('dragging');
      try { r.releasePointerCapture(e.pointerId); } catch {}
      dragTarget = null;
      savePositions();
    });

    r.addEventListener('pointercancel', () => {
      r.classList.remove('dragging');
      dragTarget = null;
    });
  });

  // Load saved positions on startup
  loadPositions();
</script>
